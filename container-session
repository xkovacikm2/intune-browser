#!/usr/bin/env bash
set -euo pipefail

export XDG_CURRENT_DESKTOP=GNOME
export XDG_SESSION_TYPE=x11
export GNOME_KEYRING_CONTROL="$XDG_RUNTIME_DIR/keyring"
export LIBGL_ALWAYS_SOFTWARE=1
export GSK_RENDERER=cairo

gnome-keyring-daemon --start --components=secrets

# GNOME reserves login for the PAM-created collection; it cannot be aliased.
alias=$(busctl --address="$DBUS_SESSION_BUS_ADDRESS" call org.freedesktop.secrets \
    /org/freedesktop/secrets org.freedesktop.Secret.Service ReadAlias s login)
if [[ "$alias" == 'o "/"' ]]; then
    if ! password=$(zenity --password --title='Create Intune login keyring' \
        --text='Choose a nonempty password for the encrypted login keyring. Existing keyrings will not be changed.'); then
        printf 'Error: login keyring creation was canceled.\n' >&2
        exit 1
    fi
    if [[ -z "$password" ]]; then
        printf 'Error: the login keyring requires a nonempty password.\n' >&2
        exit 1
    fi
    printf '%s' "$password" | gnome-keyring-daemon --replace --unlock --components=secrets
    unset password
fi
for collection in default login; do
    probe=$(dbus-uuidgen)
    if ! printf '%s' "$probe" | secret-tool store --collection="$collection" \
        --label='Intune browser secure-storage check' workutils-preflight "$probe"; then
        printf 'Error: cannot write to the %s keyring. Unlock it when prompted, then retry.\n' "$collection" >&2
        exit 1
    fi
    stored=$(secret-tool lookup workutils-preflight "$probe")
    secret-tool clear workutils-preflight "$probe"
    if [[ "$stored" != "$probe" ]]; then
        printf 'Error: the %s keyring did not return the secure-storage check value.\n' "$collection" >&2
        exit 1
    fi
done
unset probe stored collection alias

case "$1" in
    check-keyring)
        printf 'Secure storage is available through both default and login aliases.\n'
        ;;
    enroll)
        exec intune-portal
        ;;
    open)
        shift
        # Keep the launch process alive until the last browser window closes.
        exec microsoft-edge --disable-gpu --disable-background-mode --no-first-run "$@"
        ;;
    *)
        printf 'Error: unknown session action: %s\n' "$1" >&2
        exit 1
        ;;
esac
