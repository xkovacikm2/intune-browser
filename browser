#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
image=workutils-intune-browser:local
container=workutils-intune-browser
label=io.workutils.intune-browser
action=${1:-open}
if (($#)); then shift; fi

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: ./browser [COMMAND]
  build           Build the Ubuntu 24.04 image with Intune and Edge.
  enroll          Open Intune for interactive enrollment.
  open [URL ...]  Open Edge (the default); stop the container on exit.
  password        Set the container user's password.
  update          Update installed packages without replacing enrollment.
  stop            Stop a running session.
  status          Show container status and resource use.
  logs            Show container service logs.

Enrollment and browser state stay in the stopped container. Do not remove it.
EOF
}

case "$action" in
    -h|--help|help) usage; exit 0 ;;
    build)
        (($# == 0)) || fail "build takes no arguments."
        exec docker build --tag "$image" "$root"
        ;;
    open) ;;
    enroll|password|update|stop|status|logs)
        (($# == 0)) || fail "$action takes no arguments."
        ;;
    *) usage >&2; fail "Unknown command: $action" ;;
esac

docker info >/dev/null
exists=false
if docker container inspect "$container" >/dev/null 2>&1; then
    exists=true
    [[ $(docker inspect --format "{{index .Config.Labels \"$label\"}}" "$container") == 1 ]] \
        || fail "Container name $container is already in use by another application."
fi

case "$action" in
    stop)
        $exists || fail "No container has been created yet."
        exec docker stop --timeout 15 "$container"
        ;;
    logs)
        $exists || fail "No container has been created yet."
        exec docker logs --tail 100 "$container"
        ;;
    status)
        if ! $exists; then
            printf 'Not created. Run ./browser build, then ./browser enroll.\n'
        else
            docker inspect --format 'Status: {{.State.Status}}; image: {{.Config.Image}}' "$container"
            if [[ $(docker inspect --format '{{.State.Running}}' "$container") == true ]]; then
                docker stats --no-stream "$container"
            fi
        fi
        exit 0
        ;;
esac

state=${XDG_STATE_HOME:-$HOME/.local/state}/workutils-intune-browser
mkdir -p -- "$state"
chmod 700 "$state"
exec 9>"$state/session.lock"
flock -n 9 || fail "Another browser session or maintenance command is already running."

if [[ "$action" == open || "$action" == enroll ]]; then
    command -v xauth >/dev/null || fail "Install xauth on the host first."
    [[ ${DISPLAY:-} =~ ^:[0-9]+(\.[0-9]+)?$ ]] \
        || fail "A local X11 DISPLAY (for example :0) is required."
    display_number=${DISPLAY#:}
    display_number=${display_number%%.*}
    [[ -S /tmp/.X11-unix/X$display_number ]] || fail "The host X11 socket is missing."
fi

if ! $exists; then
    docker image inspect "$image" >/dev/null 2>&1 || fail "Build the image first: ./browser build"
    docker create --name "$container" --hostname intune-browser \
        --label "$label=1" \
        --security-opt "seccomp=$root/browser-seccomp.json" \
        --shm-size 256m \
        --tmpfs /run:rw,nosuid,nodev,mode=0755 \
        --tmpfs /tmp:rw,nosuid,nodev,mode=1777 \
        --mount type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix,readonly \
        "$image" >/dev/null
fi

cookie=
cleanup() {
    local result=$?
    trap - EXIT
    if [[ -n "$cookie" ]]; then rm -f -- "$cookie"; fi
    if ! docker stop --timeout 15 "$container" >/dev/null; then
        printf 'Error: could not stop %s; run ./browser stop.\n' "$container" >&2
        if ((result == 0)); then result=1; fi
    fi
    exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

docker start "$container" >/dev/null
ready=false
for ((attempt = 0; attempt < 60; attempt++)); do
    if docker exec "$container" test -f /run/intune-browser-ready; then
        ready=true
        break
    fi
    [[ $(docker inspect --format '{{.State.Running}}' "$container") == true ]] || break
    sleep 1
done
if ! $ready; then
    docker logs --tail 60 "$container" >&2
    fail "Container services did not start."
fi

case "$action" in
    password)
        [[ -t 0 && -t 1 ]] || fail "Setting a password requires an interactive terminal."
        docker exec -it "$container" passwd browser
        ;;
    update)
        docker exec "$container" bash -euc \
            'apt-get update; apt-get upgrade -y; apt-get clean; rm -rf /var/lib/apt/lists/*'
        ;;
    open|enroll)
        cookie=$(mktemp "$state/xauthority.XXXXXXXX")
        xauth nlist "$DISPLAY" | sed 's/^..../ffff/' | xauth -f "$cookie" nmerge -
        [[ -s "$cookie" ]] || fail "No X11 authentication cookie was found for $DISPLAY."
        docker exec -i "$container" sh -ec \
            'umask 077; cat > /run/browser.Xauthority; chown browser:browser /run/browser.Xauthority' \
            < "$cookie"
        rm -f -- "$cookie"
        cookie=
        docker exec --user browser \
            --env HOME=/home/browser --env "DISPLAY=$DISPLAY" \
            --env XAUTHORITY=/run/browser.Xauthority \
            --env XDG_RUNTIME_DIR=/run/user/1000 \
            "$container" dbus-run-session -- /usr/local/bin/container-session "$action" "$@"
        ;;
esac
